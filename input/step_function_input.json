{
  "bear": "<clumio api bearer token>",
  "cross_acocunt_cloudformation_role_name": "CrossAccountClumioLambdaCFTRole",
  "api_url": "<clumio api url>",
  "stack_name": "<stack name to create>",
  "connections": [
    {
      "aws_account_id_list": [
        "<aws account id 1>"
      ],
      "aws_region_list": [
        "us-east-1",
        "us-west-2"
      ],
      "aws_service_list": [
        "EBS",
        "S3",
        "RDS",
        "DynamoDB"
      ]
    },
    {
      "aws_account_id_list": [
        "<aws account id 2>",
        "<aws account id 3>"
      ],
      "aws_region_list": [
        "us-east-2"
      ],
      "aws_service_list": [
        "S3"
      ]
    }
  ]
}
